{
  "name": "backtranslation-practice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync-materials": "node scripts/sync-materials.mjs",
    "check": "node --check dist/app.js && node --check worker/src/index.js && node scripts/check-materials.mjs",
    "test": "node --test tests/worker.test.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:dry-run": "wrangler deploy --dry-run --config worker/wrangler.jsonc"
  },
  "devDependencies": {
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0",
    "wrangler": "^4.50.0"
  }
}
