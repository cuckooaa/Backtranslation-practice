{
  "name": "backtranslation-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "vars": {
    "ALLOWED_ORIGINS": "[\"http://localhost:3000\",\"http://127.0.0.1:3000\",\"https://cuckooaa.github.io\"]",
    "AI_ENABLED": "true",
    "DEEPSEEK_MODEL": "deepseek-v4-pro",
    "MAX_OUTPUT_TOKENS": "4096"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
}
